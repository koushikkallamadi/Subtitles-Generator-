# Cookie signing secret; generate a long random value before deployment.
SECRET_KEY=
# Google OAuth application ID.
GOOGLE_CLIENT_ID=
# Google OAuth application secret.
GOOGLE_CLIENT_SECRET=
# Public frontend URL used for OAuth redirects.
FRONTEND_URL=
# Public backend URL used to build the Google OAuth callback.
BACKEND_URL=
# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=
# HTTP listen port supplied by the hosting platform.
PORT=
# SQLite database file path.
DATABASE_PATH=
# Persistent uploaded project media directory.
UPLOAD_DIR=
# Generated export directory.
EXPORT_DIR=
# Temporary transcription and export working directory.
TEMP_DIR=
# Directory searched for bundled subtitle fonts.
FONT_DIR=
# Maximum incoming media size in megabytes. Raise to 500 (for example) for full-quality exports.
MAX_UPLOAD_MB=
# Maximum permitted video duration in seconds.
MAX_VIDEO_SECONDS=
# Project media retention period in days.
MEDIA_RETENTION_DAYS=
# FFmpeg executable path or command name.
FFMPEG_PATH=
# FFprobe executable path or command name.
FFPROBE_PATH=
# Credits granted to new users.
FREE_INITIAL_CREDITS=
# Default speech recognition provider.
TRANSCRIPTION_PROVIDER=
# Sarvam API credential.
SARVAM_API_KEY=
# Base URL for Sarvam API requests.
SARVAM_API_BASE_URL=
# Groq API credential.
GROQ_API_KEY=
# Base URL for Groq API requests.
GROQ_API_BASE_URL=
# OpenAI API credential.
OPENAI_API_KEY=
# Base URL for OpenAI API requests.
OPENAI_API_BASE_URL=
# Default translation provider.
TRANSLATION_PROVIDER=
# Gemini API credential.
GEMINI_API_KEY=
# Google OAuth authorization endpoint.
GOOGLE_AUTH_URL=
# Google OAuth token endpoint.
GOOGLE_TOKEN_URL=
# Text processing provider.
TEXT_PROVIDER=
# Groq chat model used for romanization.
ROMANIZATION_MODEL=
# Existing application free-plan duration setting.
FREE_MAX_SECONDS=
# Transcription credit rate per minute.
CREDIT_COST_PER_MINUTE=
# Translation credit rate per minute.
TRANSLATION_COST_PER_MINUTE=
# Caption timing strategy.
TIMING_STRATEGY=

# Maximum output video height in pixels; 0 preserves the source resolution.
EXPORT_MAX_HEIGHT=
# x264 speed preset used for exports (default: veryfast).
EXPORT_PRESET=
# x264 quality value from 0 (lossless) to 51 (smallest); default: 18.
EXPORT_CRF=
